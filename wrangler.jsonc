{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pawmc",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-17",
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AssistantDurableObject",
				"name": "ASSISTANT_DO"
			}
		]
	},
	"exports": {
		"AssistantDurableObject": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS"
	}
}