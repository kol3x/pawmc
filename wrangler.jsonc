{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pawmc",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-17",
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AssistantDurableObject",
				"name": "ASSISTANT_DO"
			}
		]
	},
	"exports": {
		"AssistantDurableObject": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	"vars": {
		"AI_PROVIDER": "workers-ai",
		"AI_MODEL_WORKERS_AI": "@cf/google/gemma-4-26b-a4b-it",
		"AI_MODEL_OPENROUTER": "z-ai/glm-5.3",
		"AI_SYSTEM_INSTRUCTION": "User values succinct and direct outputs without extra formatting, warnings, and politeness."
	},
	"secrets": { "required": ["API_KEY"] },
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS"
	}
}